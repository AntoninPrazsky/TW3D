<Project>
  <!-- NuGet package versions are managed centrally in one place -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
    <PackageVersion Include="MonoGame.Framework.Android" Version="3.8.6" />
    <!-- Content pipeline (content/Content.mgcb); runs the dotnet-mgcb tool of the same version (.config/dotnet-tools.json) -->
    <PackageVersion Include="MonoGame.Content.Builder.Task" Version="3.8.6" />
    <PackageVersion Include="Aether.Physics2D.MG" Version="2.2.0" />
    <PackageVersion Include="Aether.Physics2D.Diagnostics.MG" Version="2.2.0" />
    <!-- tools/CollisionGen: the same physics engine without MonoGame, and polygon clipping -->
    <PackageVersion Include="Aether.Physics2D" Version="2.2.0" />
    <PackageVersion Include="Clipper2" Version="2.0.0" />
  </ItemGroup>
</Project>
