<Project>
  <!-- NuGet package versions are managed centrally in one place -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
  </ItemGroup>
</Project>
