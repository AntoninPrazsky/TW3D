<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of what needs no graphics device: the shipped content (catalog, levels, collision shapes, previews), the
    score of a run, the rules of the tutorial and the settings (the colours of the cars). Run by `dotnet test` and by the CI (.github/workflows/build.yml).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TW3D.Tests</RootNamespace>
    <AssemblyName>TW3D.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Files of the game compiled in, rather than a reference to the game (a program built with its content and a
    window): only plain logic with no MonoGame in it.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\TW3D.Game\GamePlay\Race.cs" Link="Game\Race.cs" />
    <Compile Include="..\..\src\TW3D.Game\GamePlay\RaceScore.cs" Link="Game\RaceScore.cs" />
    <Compile Include="..\..\src\TW3D.Game\GamePlay\Tutorial.cs" Link="Game\Tutorial.cs" />
    <Compile Include="..\..\src\TW3D.Game\Input\CarControl.cs" Link="Game\CarControl.cs" />
    <Compile Include="..\..\src\TW3D.Game\Audio\Synth.cs" Link="Game\Synth.cs" />
    <Compile Include="..\..\src\TW3D.Game\Audio\SoundBakes.cs" Link="Game\SoundBakes.cs" />
    <!-- How loud and how high the shock absorbers creak from how fast their springs move -->
    <Compile Include="..\..\src\TW3D.Game\GamePlay\SpringCreak.cs" Link="Game\SpringCreak.cs" />
    <!-- The heights the 3D scene may be drawn at (the Resolution row of the Options menu) -->
    <Compile Include="..\..\src\TW3D.Game\Graphics\RenderResolution.cs" Link="Game\RenderResolution.cs" />
    <!-- The sizes of the shadow maps (the Shadow detail row of the Options menu), and the Raspberry Pi that keeps the low one -->
    <Compile Include="..\..\src\TW3D.Game\Graphics\ShadowDetail.cs" Link="Game\ShadowDetail.cs" />
    <Compile Include="..\..\src\TW3D.Game\Graphics\PiGraphics.cs" Link="Game\PiGraphics.cs" />
    <!-- The surfaces of the blocks: the noise they are drawn from and the Surface detail row of the Options menu -->
    <Compile Include="..\..\src\TW3D.Game\Graphics\Surface.cs" Link="Game\Surface.cs" />
    <Compile Include="..\..\src\TW3D.Game\Graphics\SurfaceDetail.cs" Link="Game\SurfaceDetail.cs" />
    <Compile Include="..\..\src\TW3D.Game\Graphics\SurfaceNoise.cs" Link="Game\SurfaceNoise.cs" />
    <Compile Include="..\..\src\TW3D.Game\Graphics\StartLightColumns.cs" Link="Game\StartLightColumns.cs" />
    <!-- How muddy the car gets on the earth of the off-road track -->
    <Compile Include="..\..\src\TW3D.Game\GameObjects\CarMud.cs" Link="Game\CarMud.cs" />
    <!-- The settings of the game and the colours of the cars chosen in the garage (the palette) -->
    <Compile Include="..\..\src\TW3D.Game\GameSettings.cs" Link="Game\GameSettings.cs" />
    <Compile Include="..\..\src\TW3D.Game\CarColours.cs" Link="Game\CarColours.cs" />
    <!-- The document of the level editor: the level being edited, with undo and redo -->
    <Compile Include="..\..\src\TW3D.Game\Editor\Layer.cs" Link="Game\Layer.cs" />
    <Compile Include="..\..\src\TW3D.Game\Editor\EditedLevel.cs" Link="Game\EditedLevel.cs" />
    <Compile Include="..\..\src\TW3D.Game\Editor\StyleNames.cs" Link="Game\StyleNames.cs" />
    <Compile Include="..\..\src\TW3D.Game\Editor\RoadGap.cs" Link="Game\RoadGap.cs" />
    <Compile Include="..\..\src\TW3D.Game\Editor\LevelReport.cs" Link="Game\LevelReport.cs" />
    <!-- The files of the editor: the levels folder, the remembered settings, the action waiting for "Save changes?" -->
    <Compile Include="..\..\src\TW3D.Game\Editor\LevelFolder.cs" Link="Game\LevelFolder.cs" />
    <Compile Include="..\..\src\TW3D.Game\Editor\EditorSettings.cs" Link="Game\EditorSettings.cs" />
    <Compile Include="..\..\src\TW3D.Game\Editor\PendingAction.cs" Link="Game\PendingAction.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TW3D.Shared\TW3D.Shared.csproj" />
  </ItemGroup>

</Project>
