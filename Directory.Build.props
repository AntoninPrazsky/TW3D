<Project>
  <!-- Společné nastavení všech projektů v src/ -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- Původní kód vznikl bez nullable anotací a implicitních usingů -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <Authors>Antonín Pražský</Authors>
    <Product>Triple Wheel 3D</Product>
    <Copyright>Copyright © Antonín Pražský 2016</Copyright>
    <Version>1.1.0</Version>
  </PropertyGroup>
</Project>
