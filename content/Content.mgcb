# The block selector of the level editor
/build:Levels/selector.obj

# Images, with their colours premultiplied by alpha as SpriteBatch draws them
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:TextureFormat=Color

# The images of the user interface: the logo of the start, the pointers, the arrows and the
# on-screen controls (converted in 2026 from the .xnb files of 2016, whose sources were lost)
/build:Common/arrow.png
/build:Common/brakepedal.png
/build:Common/cursor.png
/build:Common/lock.png
/build:Common/logo.png
/build:Common/slider.png
/build:Common/socket.png
/build:Common/stick.png

# Preview images of the levels in the level select, 700 x 394: the track alone (H while driving
# in a Debug build). A new level: a PNG of the same size and a /build line (a debug level may go
# without: the level select draws its name instead).
/build:Levels/levimgs/training1.png
/build:Levels/levimgs/training2.png
/build:Levels/levimgs/training3.png
/build:Levels/levimgs/lock.png
/build:Levels/levimgs/startblock.png
/build:Levels/levimgs/tunel.png
/build:Levels/levimgs/summit.png
/build:Levels/levimgs/docks.png
/build:Levels/levimgs/valley.png
/build:Levels/levimgs/creek.png
/build:Levels/levimgs/swamp.png
/build:Levels/levimgs/quarry.png
/build:Levels/levimgs/ridge.png
