# Content pipeline project: builds the 3D models of the game (OBJ + MTL), the shaders, the images
# and the glyph font into .xnb files. The projects reference it as MonoGameContentReference, the
# build output goes to Content/ next to the program. The other files in content/ (precompiled
# fonts, levels, the catalog) are copied as they are.
#
# A new model: add a /build line below the models.

#----------------------------- Global Properties ----------------------------#

/profile:Reach
/compress:False

# The extension of the pipeline (tools/ContentPipeline), built by the projects before the content
/reference:../tools/ContentPipeline/bin/TW3D.ContentPipeline.dll

#---------------------------------- Content ---------------------------------#

# Shaders. The processor of tools/ContentPipeline compiles them and keeps their code for DesktopGL in Effects/DesktopGL,
# which the builds on Linux (a Raspberry Pi) take: the effect compiler runs only on Windows. A changed shader:
# build on Windows and commit the files it writes there too.
/importer:EffectImporter
/processor:PrecompiledEffectProcessor
/build:Effects/Scene.fx
/build:Effects/Occlusion.fx

# The fonts: the menus and the display of a run in four sizes and the frame rate counter, from TripleWheelDisplay.ttf
# (tools/fontgen), the glyphs of the keys and buttons on the tutorial cards, from PromptFont.ttf, and the font of the
# debug view of Aether.Physics2D (development keys), from DejaVuSans.ttf, which it loads as DiagnosticsFont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/build:Fonts/menuFont20.spritefont
/build:Fonts/menuFont40.spritefont
/build:Fonts/menuFont80.spritefont
/build:Fonts/menuFont160.spritefont
/build:Fonts/promptFont.spritefont
/build:Fonts/frameRateCounterFont.spritefont
/build:Fonts/diagnosticsFont.spritefont;DiagnosticsFont.spritefont

# The FbxImporter reads any format Assimp knows, OBJ too, and unlike the OpenAssetImporter
# it creates XNA compatible materials (BasicEffect), which the game draws with. The processor
# of tools/ContentPipeline adds what metal the materials are (Pm and Pr of the .mtl files).
/importer:FbxImporter
/processor:MtlModelProcessor

# Vehicles
/build:car.obj
/build:car2.obj
/build:car3.obj
/build:holder.obj
/build:wheel.obj
/build:wheel2.obj
/build:wheel3.obj

# The wheels mirrored front to back, for the near side of a car: they turn their tread the same
# way as the wheels on the far side, which are turned around (GameObjects/Car.cs)
/processorParam:Mirrored=True
/build:wheel.obj;wheel-mirrored.xnb
/build:wheel2.obj;wheel2-mirrored.xnb
/build:wheel3.obj;wheel3-mirrored.xnb
/processorParam:Mirrored=False

# Dynamic objects, with their triangles for the skid marks of the tyres to lie on (GameObjects/SkidMarks.cs)
/processorParam:Surface=True
/build:Env/bar1.obj
/build:Env/bar2.obj
/build:Env/box.obj
/build:Env/co.obj
/build:Env/co2.obj
/build:Env/mov1.obj
/build:Env/rm.obj
/build:Env/tb1.obj
/processorParam:Surface=False

# The 3D garage behind the menus and the 3D logo of the main menu
/build:Garage/garage.obj
/build:Garage/logo.obj

# Scenery: static props beside the track, without physics (tools/garagegen/scenery.py)
/build:Scenery/chain.obj
/build:Scenery/cone.obj
/build:Scenery/fence.obj
/build:Scenery/guardrail.obj
/build:Scenery/guardrail2.obj
/build:Scenery/lamp.obj
/build:Scenery/pole.obj
/build:Scenery/stand.obj

