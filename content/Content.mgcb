# Content pipeline project: builds the 3D models of the game (OBJ + MTL, their textures
# are built with them) and the shaders into .xnb files. The projects reference it as
# MonoGameContentReference, the build output goes to Content/ next to the program. The other
# files in content/ (precompiled textures and fonts, levels, the catalog) are copied as they are.
#
# A new model: add a /build line below the models.

#----------------------------- Global Properties ----------------------------#

/profile:Reach
/compress:False

# The extension of the pipeline (tools/ContentPipeline), built by the projects before the content
/reference:../tools/ContentPipeline/bin/TW3D.ContentPipeline.dll

#---------------------------------- Content ---------------------------------#

# Shaders
/importer:EffectImporter
/processor:EffectProcessor
/build:Effects/Scene.fx
/build:Effects/Occlusion.fx

# The FbxImporter reads any format Assimp knows, OBJ too, and unlike the OpenAssetImporter
# it creates XNA compatible materials (BasicEffect), which the game draws with. The processor
# of tools/ContentPipeline adds what metal the materials are (Pm and Pr of the .mtl files).
/importer:FbxImporter
/processor:MtlModelProcessor

# Vehicles
/build:car.obj
/build:car2.obj
/build:holder.obj
/build:wheel.obj
/build:wheel2.obj

# Dynamic objects and the sky
/build:Env/bar1.obj
/build:Env/bar2.obj
/build:Env/box.obj
/build:Env/co.obj
/build:Env/co2.obj
/build:Env/mov1.obj
/build:Env/rm.obj
/build:Env/sky.obj
/build:Env/tb1.obj

# Track blocks
/build:Levels/mod/a1.obj
/build:Levels/mod/b1.obj
/build:Levels/mod/b1f.obj
