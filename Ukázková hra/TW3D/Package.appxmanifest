  <Identity Name="75c5872f-839f-4ca0-9ef7-a02ced471eb1" Publisher="CN=PanRD" Version="1.0.0.0" />
  <mp:PhoneIdentity PhoneProductId="75c5872f-839f-4ca0-9ef7-a02ced471eb1" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>TW3D</DisplayName>
    <PublisherDisplayName>Antonín Pražský</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
