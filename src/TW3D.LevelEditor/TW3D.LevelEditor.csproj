<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The editor is Windows only: it uses the Windows Forms Open/Save dialogs
    and P/Invoke into user32.dll (toggling Caps Lock). The output is a console
    application, because the console window serves as the editor's command line.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RollForward>Major</RollForward>
    <RootNamespace>LevelEditor</RootNamespace>
    <AssemblyName>LevelEditor</AssemblyName>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The renderer of the 3D scene, shared with the game -->
    <Compile Include="..\TW3D.Game\Graphics\SceneRenderer.cs;..\TW3D.Game\Graphics\Lighting.cs" LinkBase="Graphics" />
  </ItemGroup>

  <ItemGroup>
    <!-- Models built by the content pipeline into Content/ -->
    <MonoGameContentReference Include="$(GameContentDir)Content.mgcb" Link="Content\Content.mgcb" OutputFolder="$(MSBuildProjectName)" />
    <!-- The other shared content (precompiled textures and fonts, levels, the catalog), copied to the output as Content/ -->
    <None Include="$(GameContentDir)**\*" Exclude="$(ContentPipelineSources)" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
    <PackageReference Include="MonoGame.Content.Builder.Task" />
    <ProjectReference Include="..\TW3D.Shared\TW3D.Shared.csproj" />
    <!-- Built for the content pipeline, which loads it (content/Content.mgcb) -->
    <ProjectReference Include="..\..\tools\ContentPipeline\ContentPipeline.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
