<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The editor is Windows only: it uses the Windows Forms Open/Save dialogs
    and P/Invoke into user32.dll (toggling Caps Lock). The output is a console
    application, because the console window serves as the editor's command line.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RollForward>Major</RollForward>
    <RootNamespace>LevelEditor</RootNamespace>
    <AssemblyName>LevelEditor</AssemblyName>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared compiled content (models, textures, fonts) and levels, copied to the output as Content/ -->
    <None Include="..\..\content\**\*" Exclude="..\..\content\**\*.spritefont" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
  </ItemGroup>

</Project>
