<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Editor je jen pro Windows: používá dialogy Otevřít/Uložit z Windows Forms
    a P/Invoke do user32.dll (přepínání Caps Lock). Výstup je konzolová aplikace,
    protože okno konzole slouží jako příkazový řádek editoru.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RollForward>Major</RollForward>
    <RootNamespace>LevelEditor</RootNamespace>
    <AssemblyName>LevelEditor</AssemblyName>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sdílený zkompilovaný obsah (modely, textury, fonty) a tratě, kopíruje se do výstupu jako Content/ -->
    <None Include="..\..\content\**\*" Exclude="..\..\content\**\*.spritefont" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
  </ItemGroup>

</Project>
